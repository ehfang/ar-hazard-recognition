# NOTE: the secrets rules are at the END of this file on purpose, so that the
# "!/[Aa]ssets/**/*.meta" rule below can't re-include the key file's .meta.

# ---------------------------------------------------------------
# Third-party training material: cite, don't host
# (OSHA Focus Four slides and anything extracted from them)
# ---------------------------------------------------------------
*.ppt
*.pptx
*.ppt.meta
*.pptx.meta

# ---------------------------------------------------------------
# Unity generated
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity XR Simulation temp settings
/[Aa]ssets/XR/Temp/
/[Aa]ssets/XR/Temp.meta

# Auto-generated by Unity Asset Store tools / plugins
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Burst / IL2CPP / Android build intermediates
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
/.utmp/

# Gradle / Android
.gradle/

# ---------------------------------------------------------------
# Builds and packages
# ---------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------
.vs/
.idea/
.vscode/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
.DS_Store
Thumbs.db
Desktop.ini

# Local backups
_backup_*/

# Temporary screenshot-capture tooling (local only)
/[Aa]ssets/_DemoCapture/
/[Aa]ssets/_DemoCapture.meta

# Empty folder the Meta SDK recreates; git cannot track empty folders
/[Aa]ssets/StreamingAssets.meta

# ---------------------------------------------------------------
# Secrets: never commit the OpenAI API key configuration
# (see README > Setup to create your own). Keep these LAST.
# ---------------------------------------------------------------
Assets/Resources/OpenAIConfiguration.asset
Assets/Resources/OpenAIConfiguration.asset.meta
